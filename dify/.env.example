# ---------------------------------------------------------------------------
# 《记仇的 NPC：铁匠阿铁》配置示例
#
# 复制成 .env 后按需修改：
#   cp .env.example .env
#
# 本文件只放占位值，不含任何真实密钥。
# ---------------------------------------------------------------------------

# ===================== PowerContext 连接 =====================
# PowerContext 服务地址（宿主机方式运行时用这个；
# 若把 PowerContext 也放进 Dify 的 Docker 网络，则用 http://powercontext:8000）
POWERCONTEXT_URL=http://127.0.0.1:8000

# 开启 Bearer 鉴权时才需要填写；留空表示不鉴权
POWERCONTEXT_TOKEN=

# 玩家标识：换一个值 = 换一个独立存档（NPC 对每个玩家单独记仇）
PLAYER_ID=player-1
PLAYER_NAME=旅人
NPC_NAME=阿铁

# ===================== Dify =====================
# Dify 控制台地址（自建 compose 默认 http://127.0.0.1）
DIFY_CONSOLE_URL=http://127.0.0.1

# 管理员账号（首次访问控制台时自行创建，或用 scripts/import_dsl.sh 自动创建）
# 注意：scripts/dify_api.sh 里内置的默认密码只用于本地演示，
#       评审/共享环境请务必在这里换成自己的密码。
DIFY_EMAIL=admin@dify.local
DIFY_PASSWORD=<在此填写你自己的管理员密码>

# Dify 1.18.0 的解压目录（scripts/start_dify.sh 用它找 docker-compose.yaml）
DIFY_DIR=<例如 /home/lyc/dify-1.18.0>

# ===================== 模型（OpenAI 兼容端点） =====================
# Dify 里安装 OpenAI-API-compatible provider 插件后，用它接任意兼容端点
MODEL_PROVIDER=langgenius/openai_api_compatible/openai_api_compatible
MODEL_NAME=MiniMax-M3.1-Flash
MODEL_BASE_URL=https://api.minimaxi.com/v1
# 在此填你的模型 API Key（不要提交到仓库）
MODEL_API_KEY=<在此填写你的模型 API Key>

# ===================== 网络（可选） =====================
# 国内网络下 PyPI 官方源可能不可达，构建 PowerContext 镜像时可以切镜像源：
# PYPI_INDEX=https://mirrors.aliyun.com/pypi/simple/
# PYPI_TRUSTED_HOST=mirrors.aliyun.com
#
# Docker Hub 拉不动时，可以给 Docker 配 registry mirror，例如：
#   /etc/docker/daemon.json -> {"registry-mirrors": ["https://docker.m.daocloud.io"]}
