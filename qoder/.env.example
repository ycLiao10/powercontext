# PowerContext 运行配置示例（无模型依赖的最小可用配置）
# 复制为 .env 后按需修改：cp .env.example .env
# 真实 token / API Key 不要提交，占位值保持原样即可通过评审

POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_MCP_ENABLED=true
POWERCONTEXT_SERVER_MCP_PATH=/mcp
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO
POWERCONTEXT_SERVER_LOGGING_FORMAT=console
POWERCONTEXT_SERVER_LOGGING_ACCESS=true
POWERCONTEXT_SERVER_METRICS_ENABLED=true
POWERCONTEXT_SERVER_TRACING_ENABLED=false
POWERCONTEXT_SERVER_RUNTIME_SOURCE_WINDOW_LIMIT=100
POWERCONTEXT_SERVER_RUNTIME_MEMORY_EXTRACTION_PROFILE=coding
POWERCONTEXT_SERVER_INFERENCE_GENERATION_TIMEOUT_SECONDS=30
POWERCONTEXT_SERVER_INFERENCE_GENERATION_MAX_REQUESTS=2
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_NORMALIZATION=unit
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BATCH_SIZE=10
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_TIMEOUT_SECONDS=30
POWERCONTEXT_SERVER_HANDOFF_REPORT_ENABLED=true
POWERCONTEXT_CLIENT_SERVER_URL=http://127.0.0.1:8000
POWERCONTEXT_CLIENT_TIMEOUT=10
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite

# 持久化路径。留空则使用操作系统用户数据目录；
# 需要固定到本目录时填绝对路径，例如 Linux/macOS：
# POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////home/<user>/qoder/data/powercontext.db
# Windows：
# POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:///C:/Users/<user>/qoder/data/powercontext.db

# 可选：接入生成模型后启用自动记忆抽取（不填则仅显式记忆 + 检索）
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_API_KEY=replace-with-your-key
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_BASE_URL=https://api.example.com/v1
# POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=replace-with-model

# 本地嵌入服务（tools/embed_server.py，OpenAI 兼容 /v1/embeddings）
# 注意：模型名必须带 provider 前缀，PowerContext 用 provider:model 推断适配器
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:BAAI/bge-small-zh-v1.5
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=bge-small-zh-v1.5-local
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=512
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_SEND_DIMENSIONS=false
# 若换成需要鉴权的云端嵌入服务，再额外设置（不要提交真实 key）：
# POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_API_KEY=replace-with-your-key
